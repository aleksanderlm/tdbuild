+void Transcribes::loadLocal(not_null<HistoryItem*> item) {
+	const auto media = item->media();
+	const auto document = media ? media->document() : nullptr;
+	if (!document) {
+		return;
+	}
+
+	const auto id = item->fullId();
+	QString tempPath = QDir::tempPath() + "/tg_voice_" + QString::number(item->id.bare) + ".ogg";
+
+	QByteArray fileData;
+	QFile file(tempPath);
+	if (file.exists() && file.open(QIODevice::ReadOnly)) {
+		fileData = file.readAll();
+	}
+
+	if (fileData.isEmpty()) {
+		document->save(id, tempPath);
+		auto &entry = _map[id];
+		entry.result = "Downloading audio...";
+		entry.shown = true;
+		entry.pending = true;
+		entry.failed = false;
+		_session->data().requestItemResize(item);
+
+		auto timer = new QTimer();
+		timer->setInterval(500);
+		QObject::connect(timer, &QTimer::timeout, [=] {
+			QFile check(tempPath);
+			if (check.exists() && check.size() > 0) {
+				timer->stop();
+				timer->deleteLater();
+				if (const auto item2 = _session->data().message(id)) {
+					loadLocal(item2);
+				}
+			}
+		});
+		timer->start();
+		return;
+	}
+
+	QString serverPath;
+#ifdef Q_OS_WIN
+	serverPath = QCoreApplication::applicationDirPath() + "/transcribe_server.exe";
+#else
+	serverPath = QDir::homePath() + "/transcribe_server";
+#endif
+
+	auto justStarted = false;
+	if (!_localProcess) {
+		_localProcess = new QProcess();
+	}
+	if (_localProcess->state() == QProcess::NotRunning) {
+		_localProcess->start(serverPath, QStringList());
+		_localProcess->waitForStarted(3000);
+		justStarted = true;
+	}
+
+	auto &entry = _map[id];
+	entry.requestId = 0;
+	entry.shown = true;
+	entry.pending = true;
+	entry.result = "Transcribing...";
+	_session->data().requestItemResize(item);
+
+	QNetworkRequest request(QUrl("http://127.0.0.1:8988/transcribe?item_id=" + QString::number(item->id.bare)));
+	request.setHeader(QNetworkRequest::ContentTypeHeader, "audio/ogg");
+	request.setTransferTimeout(120000);
+
+	const auto sendRequest = [=] {
+		const auto reply = _localNetwork.post(request, fileData);
+		QObject::connect(reply, &QNetworkReply::finished, [=] {
+			if (reply->error() == QNetworkReply::NoError) {
+				const auto data = reply->readAll();
+				const auto doc = QJsonDocument::fromJson(data);
+				const auto text = doc.object().value("text").toString();
+
+				auto &e = _map[id];
+				e.result = text;
+				e.pending = false;
+			} else {
+				auto &e = _map[id];
+				e.result = "Local transcription failed: " + reply->errorString();
+				e.pending = false;
+				e.failed = true;
+			}
+			if (const auto item = _session->data().message(id)) {
+				_session->data().requestItemResize(item);
+			}
+			reply->deleteLater();
+		});
+	};
+
+	if (justStarted) {
+		QTimer::singleShot(1500, sendRequest);
+	} else {
+		sendRequest();
+	}
+}
